# FastAPI Server Configuration
PROJECT_NAME="JARVIS AI Assistant"
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# LLM Configuration
# Options: placeholder, openai, groq (future support: claude, gemini, etc.)
LLM_PROVIDER="groq"
OPENAI_API_KEY=""
GROQ_API_KEY=""
MODEL_NAME="llama-3.3-70b-versatile"
REQUEST_TIMEOUT=60

# Voice Configuration
VOICE_ENABLED=true
VOICE_NAME="en_US-lessac-medium"
STT_PROVIDER="faster_whisper"
TTS_PROVIDER="piper"
STT_MODEL="base"
VOICE_MODELS_DIR="voice/models"
PIPER_BIN_DIR="voice/bin/piper"

# Database and Memory Settings
DATABASE_URL="sqlite+aiosqlite:///database/jarvis.db"
SQLITE_DB_PATH="database/jarvis.db"
CHROMA_DB_PATH="database/chroma"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
MEMORY_TOP_K=5
SIMILARITY_THRESHOLD=0.35

